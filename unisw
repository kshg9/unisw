#! /usr/bin/env nix-shell
#! nix-shell -i python3 -p python3

import argparse
from argparse import Namespace
from contextlib import contextmanager
import errno
import os
import shutil
import stat
import sys
import tomllib
import uuid
from collections.abc import Callable, Iterator
from pathlib import Path


class UniswError(Exception):
    pass


type Undo = Callable[[], None]
type Step = Callable[[Undo, Undo], None]


@contextmanager
def transaction(operation: str) -> Iterator[Step]:
    """Compose filesystem steps and undo them in reverse order on failure."""
    undo_stack: list[Undo] = []

    def step(action: Undo, undo: Undo) -> None:
        action()
        undo_stack.append(undo)

    try:
        yield step
    except BaseException as error:
        for undo in reversed(undo_stack):
            try:
                undo()
            except Exception as e:
                print(f"warning: rollback step failed: {e}", file=sys.stderr)

        if isinstance(error, OSError):
            raise UniswError(
                f"{operation} failed and was rolled back: {error}"
            ) from error
        raise


def xdg_home(name: str, default: Path) -> Path:
    value = os.environ.get(name)
    path = Path(value).expanduser() if value else default
    return path if path.is_absolute() else default


def config_path() -> Path:
    return (
        xdg_home("XDG_CONFIG_HOME", Path.home() / ".config") / "unisw" / "config.toml"
    )


def vault_root() -> Path:
    return (
        xdg_home("XDG_DATA_HOME", Path.home() / ".local" / "share") / "unisw" / "vault"
    )


def validate_component(value: str, kind: str) -> str:
    if not value or value in {".", ".."} or Path(value).name != value:
        raise UniswError(f"Invalid {kind} {value!r}; it must be one path component.")
    return value


def profile_dir(app: str, profile: str) -> Path:
    return (
        vault_root()
        / validate_component(app, "app name")
        / validate_component(profile, "profile name")
    )


def path_exists(path: Path) -> bool:
    return path.exists() or path.is_symlink()


def load_config() -> dict:
    path = config_path()
    if not path.is_file():
        raise UniswError(
            f"Config file not found: {path}\nCreate it manually; unisw never modifies config."
        )
    with path.open("rb") as file:
        return tomllib.load(file)


def app_paths(config: dict, app: str) -> list[Path]:
    validate_component(app, "app name")
    section = config.get(app)
    values = section.get("paths") if isinstance(section, dict) else None
    if not isinstance(values, list) or not values:
        raise UniswError(f"App {app!r} must define a non-empty paths array.")
    paths = []
    for value in values:
        if not isinstance(value, str) or not value:
            raise UniswError("Every configured path must be a non-empty string.")
        path = Path(value).expanduser()
        if not path.is_absolute():
            raise UniswError(f"Configured path must be absolute: {value!r}")
        path = Path(os.path.normpath(path))
        if any(
            path.is_relative_to(other) or other.is_relative_to(path) for other in paths
        ):
            raise UniswError(f"Configured paths overlap: {path}")
        paths.append(path)
    return paths


def managed_target(path: Path) -> Path | None:
    """Resolved vault path if `path` is a symlink we manage, else None."""
    if not path.is_symlink():
        return None
    try:
        target = path.resolve(strict=True)
    except OSError:
        return None
    if target.is_dir() and target.is_relative_to(vault_root().resolve(strict=False)):
        return target
    return None


def raw_directory(path: Path) -> None:
    if path.is_symlink():
        raise UniswError(f"Refusing unexpected symlink at {path}.")
    if path_exists(path) and not path.is_dir():
        raise UniswError(f"Configured target must be a directory: {path}")


def validate_new_target(path: Path) -> bool:
    """Validate one new-login target and return whether it contains raw data."""
    if path.is_symlink():
        if managed_target(path) is None:
            raise UniswError(f"Refusing unexpected symlink at {path}.")
        return False
    raw_directory(path)
    return path.exists()


def remove_readonly(
    func: Callable[[str], None], path: str, _exc: BaseException
) -> None:
    os.chmod(path, stat.S_IWRITE)
    func(path)


def clear_target(path: Path) -> None:
    if path.is_symlink():
        path.unlink()
    elif path.exists():
        shutil.rmtree(path, onexc=remove_readonly)
    path.parent.mkdir(parents=True, exist_ok=True)


def confirm_delete(paths: list[Path]) -> bool:
    if not paths:
        return True
    prompt = f"Delete raw unsaved data at {', '.join(map(str, paths))}? [y/N]: "
    return input(prompt).lower() == "y"


def stage_target(path: Path, slot: Path, step: Step) -> None:
    if not path.exists():
        step(slot.mkdir, slot.rmdir)
        return

    def do_move():
        try:
            path.rename(slot)
        except OSError as e:
            if e.errno == errno.EXDEV:
                raise UniswError(
                    f"Cannot snatch {path}: it is on a different filesystem than the vault. "
                    "Atomic switching requires both to be on the same drive."
                ) from e
            raise

    # rename() moves the directory entry; symlinks inside it are not traversed.
    step(do_move, lambda: slot.rename(path))


def replace_link(path: Path, target: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.unisw-{uuid.uuid4().hex}")
    try:
        temporary.symlink_to(target, target_is_directory=True)
        temporary.replace(path)
    finally:
        if temporary.is_symlink():
            temporary.unlink()


def execute_new(app: str, config: dict) -> None:
    paths = app_paths(config, app)
    raw = [path for path in paths if validate_new_target(path)]
    if not confirm_delete(raw):
        raise UniswError("Aborted. Snatch the data first to preserve it.")
    for path in paths:
        clear_target(path)
    print(f"Ready for a fresh {app!r} login.")


def execute_snatch(app: str, profile: str, config: dict) -> None:
    paths, vault = app_paths(config, app), profile_dir(app, profile)
    if path_exists(vault):
        raise UniswError(
            f"Profile {profile!r} already exists; refusing to overwrite it."
        )
    for path in paths:
        raw_directory(path)

    with transaction("Snatch") as step:
        step(lambda: vault.mkdir(parents=True), vault.rmdir)
        for index, path in enumerate(paths):
            slot = vault / f"path_{index}"
            stage_target(path, slot, step)
            step(
                lambda p=path, s=slot: replace_link(p, s),
                lambda p=path: p.unlink() if p.is_symlink() else None,
            )
    print(f"Successfully snatched {app!r} into {profile!r}.")


def execute_switch(app: str, profile: str, config: dict) -> None:
    paths, vault = app_paths(config, app), profile_dir(app, profile)
    slots = [vault / f"path_{index}" for index in range(len(paths))]
    if not vault.is_dir() or vault.is_symlink():
        raise UniswError(f"Profile {profile!r} is missing or unsafe.")
    if any(not slot.is_dir() or slot.is_symlink() for slot in slots):
        raise UniswError(f"Profile {profile!r} is incomplete or unsafe.")
    expected = {slot.name for slot in slots}
    if (actual := {p.name for p in vault.iterdir()}) != expected:
        raise UniswError(
            f"Profile {profile!r} doesn't match the current config: "
            f"unexpected {sorted(actual - expected)}, missing {sorted(expected - actual)}"
        )
    for path in paths:
        if path.is_symlink() and managed_target(path) is None:
            raise UniswError(f"Refusing unexpected symlink at {path}.")
        if not path.is_symlink() and path.exists():
            raise UniswError(
                f"{path} contains unsaved data; snatch it before switching."
            )

    with transaction("Switch") as step:
        for path, slot in zip(paths, slots):
            old = path.readlink() if path.is_symlink() else None

            def restore(p=path, o=old):
                if p.is_symlink():
                    p.unlink()
                if o is not None:
                    replace_link(p, o)

            step(lambda p=path, s=slot: replace_link(p, s), restore)
    print(f"Successfully switched {app!r} to {profile!r}.")


def profile_names(directory: Path) -> list[str]:
    if not directory.is_dir() or directory.is_symlink():
        return []
    return sorted(
        path.name
        for path in directory.iterdir()
        if path.is_dir() and not path.is_symlink()
    )


def active_profile(app: str, config: dict) -> str | None:
    """Determine which profile is currently active for an app."""
    try:
        paths = app_paths(config, app)
    except UniswError:
        return None

    for path in paths:
        if (target := managed_target(path)) is not None:
            return target.parent.name
    return None


def execute_ls(app: str | None) -> None:
    if app is not None:
        validate_component(app, "app name")
    root = vault_root()
    if not root.is_dir():
        print("No profiles found.")
        return

    # Load config to determine active profiles
    try:
        config = load_config()
    except UniswError:
        config = {}

    app_dirs = (
        [root / app]
        if app
        else sorted(
            path for path in root.iterdir() if path.is_dir() and not path.is_symlink()
        )
    )

    found = False
    for directory in app_dirs:
        profiles = profile_names(directory)
        if not profiles:
            continue
        found = True
        active = active_profile(directory.name, config)
        print(f"\n[{directory.name}]")
        for profile in profiles:
            marker = " [active]" if profile == active else ""
            print(f"  - {profile}{marker}")

    if not found:
        print("No profiles found.")


def execute_mv(app: str, old: str, new: str, config: dict) -> None:
    paths, source, destination = (
        app_paths(config, app),
        profile_dir(app, old),
        profile_dir(app, new),
    )
    if not source.is_dir() or source.is_symlink():
        raise UniswError(f"Profile {old!r} does not exist in {app!r}.")
    if path_exists(destination):
        raise UniswError(f"Profile {new!r} already exists in {app!r}.")
    active = source.resolve()
    for path in paths:
        if (target := managed_target(path)) and target.is_relative_to(active):
            raise UniswError(f"Profile {old!r} is active; switch away before renaming.")
    source.rename(destination)
    print(f"Successfully renamed {old!r} to {new!r}.")


class CLIArgs(Namespace):
    command: str
    app: str | None
    profile: str | None
    old: str | None
    new: str | None
    handler: Callable[["CLIArgs"], None]


def main() -> None:
    parser = argparse.ArgumentParser(description="Universal Account Switcher")
    commands = parser.add_subparsers(dest="command", metavar="COMMAND", required=True)

    sub = commands.add_parser("new", help="Clear paths for a fresh login")
    sub.add_argument("app")
    sub.set_defaults(handler=lambda a: execute_new(a.app, load_config()))

    sub = commands.add_parser("snatch", help="Snapshot current state")
    sub.add_argument("app")
    sub.add_argument("profile")
    sub.set_defaults(handler=lambda a: execute_snatch(a.app, a.profile, load_config()))

    sub = commands.add_parser("switch", help="Switch to a profile")
    sub.add_argument("app")
    sub.add_argument("profile")
    sub.set_defaults(handler=lambda a: execute_switch(a.app, a.profile, load_config()))

    sub = commands.add_parser("mv", help="Rename a profile")
    sub.add_argument("app")
    sub.add_argument("old")
    sub.add_argument("new")
    sub.set_defaults(handler=lambda a: execute_mv(a.app, a.old, a.new, load_config()))

    sub = commands.add_parser("ls", help="List profiles")
    sub.add_argument("app", nargs="?")
    sub.set_defaults(handler=lambda a: execute_ls(a.app))

    if len(sys.argv) == 1:
        parser.print_help()
        raise SystemExit(2)

    args = parser.parse_args(namespace=CLIArgs())
    try:
        args.handler(args)
    except (EOFError, OSError, tomllib.TOMLDecodeError, UniswError) as e:
        print(f"Error: {e}", file=sys.stderr)
        raise SystemExit(1) from e


if __name__ == "__main__":
    main()
